<Window x:Class="Fl0w3R.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Fl0w3R"
        mc:Ignorable="d"
        Title="Fl0w3R" Height="500" Width="1100" Loaded="Window_Loaded">


    <Grid Background="Black">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="341*" />
            <ColumnDefinition Width="210*"/>
            <ColumnDefinition Width="275*" />
            <ColumnDefinition Width="275*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <!-- Depth Image -->
        <Image x:Name="kinectDepthImage"
               Grid.Column="0"
               Grid.Row="0"
               HorizontalAlignment="Left"
               Margin="10,0,0,0"
               VerticalAlignment="Top"/>

        <!--Color Image -->
        <Image x:Name="kinectColorImage"
               Grid.Column="3"
               Grid.Row="0"
               HorizontalAlignment="Right"
               VerticalAlignment="Top" Margin="0,0,275,0"
               />
        <Image x:Name="flowerImage" Grid.Column="3" Margin="10,0,10,0" Stretch="Uniform" VerticalAlignment="Center" />

        <!--Debug Text -->
        <TextBlock x:Name="debugText"
                   Grid.ColumnSpan="2"
                   Grid.Row="1"
                   Foreground="Lime"
                   FontSize="20"
                   Text="Zone: -- | Depth: -- mm"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center" Margin="309,0,0,0"/>
    </Grid>
</Window>
