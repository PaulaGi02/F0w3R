<Window x:Class="Fl0w3R.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Fl0w3R"
        mc:Ignorable="d"
        Title="Fl0w3R" Height="500" Width="1100" Loaded="Window_Loaded" MouseMove="Window_MouseMove">

    <Grid>
        <!-- start screen -->
        <Grid x:Name="startScreenGrid" Visibility="Visible">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="20" VerticalAlignment="Center">
                <TextBlock Text="Fl0w3R" FontSize="32" FontWeight="Bold" Margin="0,0,0,20"/>
                <TextBlock TextWrapping="Wrap" FontSize="16">
                    Lets play a game. Remember the flower stages.
                    Move away or closer to the sensor to match the Zone.
                    Hold the position for 2 seconds.
                </TextBlock>
                <Button x:Name="startButton" Content="Start" FontSize="20" Margin="0,30,0,0" Height="50" Click="StartButton_Click" Background="LightGray"/>
            </StackPanel>

            <!-- test preview area, reuses existing kinect images -->
            <Image x:Name="kinectDepthImageStart" Grid.Column="1" Margin="10" Stretch="Uniform"/>
            <Image x:Name="flowerPreviewImage" Grid.Column="2" Margin="10" Stretch="Uniform"/>
        </Grid>

        <!-- game screen (v2: four tiles) -->
        <Grid x:Name="gameScreenGrid" Visibility="Collapsed" Background="#1E1E24">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="110"/>
            </Grid.RowDefinitions>

            <!-- status: score / phase -->
            <TextBlock x:Name="statusText" Grid.Row="0" Text="Score: 0" FontSize="24" FontWeight="Bold"
               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- the four tiles -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="20,0">
                <Border x:Name="tile0" Background="#64B5F6" CornerRadius="16" Margin="10" BorderBrush="Transparent" BorderThickness="6">
                    <Image x:Name="tileImg0" Stretch="Uniform" Margin="20"/>
                </Border>
                <Border x:Name="tile1" Background="#BA68C8" CornerRadius="16" Margin="10" BorderBrush="Transparent" BorderThickness="6">
                    <Image x:Name="tileImg1" Stretch="Uniform" Margin="20"/>
                </Border>
                <Border x:Name="tile2" Background="#F06292" CornerRadius="16" Margin="10" BorderBrush="Transparent" BorderThickness="6">
                    <Image x:Name="tileImg2" Stretch="Uniform" Margin="20"/>
                </Border>
                <Border x:Name="tile3" Background="#FFB74D" CornerRadius="16" Margin="10" BorderBrush="Transparent" BorderThickness="6">
                    <Image x:Name="tileImg3" Stretch="Uniform" Margin="20"/>
                </Border>
            </UniformGrid>

            <!-- small helper view: depth image + debug text -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="kinectDepthImage" Grid.Column="0" Margin="10" Stretch="Uniform"/>
                <TextBlock x:Name="debugText" Grid.Column="1" FontSize="14" Foreground="Gray"
                   Margin="10" VerticalAlignment="Center" Text="--"/>
            </Grid>

            <!-- old v1 elements, hidden so the old code still compiles; removed in step 4 -->
            <Image x:Name="kinectColorImage" Visibility="Collapsed"/>
            <Image x:Name="flowerImage" Visibility="Collapsed"/>
            <ProgressBar x:Name="dwellProgressBar" Visibility="Collapsed" Minimum="0" Maximum="100"/>
        </Grid>


        <!-- Display game over -->
        <Grid x:Name="gameOverGrid" Visibility="Collapsed" Background="#CC000000">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="gameOverText" Text="Game Over" FontSize="36" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="finalScoreText" Text="Score: 0" FontSize="24" Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,20"/>
                <Button Content="Nochmal spielen" FontSize="18" Height="40" Click="RestartButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

