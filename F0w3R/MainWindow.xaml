<Window x:Class="Fl0w3R.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Fl0w3R"
        mc:Ignorable="d"
        Title="Fl0w3R" Height="500" Width="1100"
        Loaded="Window_Loaded">

    <Grid>
        <!-- start screen -->
        <Grid x:Name="startScreenGrid" Visibility="Visible" Background="#1E1E24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- title, instructions, start -->
            <StackPanel Grid.Column="0" Margin="30" VerticalAlignment="Center">
                <TextBlock Text="Fl0w3R" FontSize="40" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                <TextBlock TextWrapping="Wrap" FontSize="15" Foreground="#DDDDDD" LineHeight="24">
                    <Run Text="Watch the flowers bloom and remember the order."/>
                    <LineBreak/>
                    <Run Text="1. Raise your hand in front of your body to point at a tile."/>
                    <LineBreak/>
                    <Run Text="2. Push your hand forward to let the flower grow."/>
                    <LineBreak/>
                    <Run Text="3. Pull your hand back to your body before the next flower."/>
                    <LineBreak/>
                    <Run Text="Every round adds one flower. One mistake ends the game."/>
                </TextBlock>
                <Button x:Name="startButton" Content="Start" FontSize="20" Height="50" Margin="0,25,0,0"
                        Click="StartButton_Click" Background="#64B5F6" Foreground="White" BorderThickness="0"/>
            </StackPanel>

            <!-- Kinect view, helps the player to position themselves -->
            <StackPanel Grid.Column="1" Margin="10" VerticalAlignment="Center">
                <TextBlock Text="Kinect view" Foreground="Gray" FontSize="13" Margin="0,0,0,5"/>
                <Image x:Name="kinectDepthImageStart" Stretch="Uniform"/>
            </StackPanel>

        </Grid>

        <!--game screen -->
        <Grid x:Name="gameScreenGrid" Visibility="Collapsed" Background="#1E1E24">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="110"/>
            </Grid.RowDefinitions>

            <!-- status: phase + progress -->
            <TextBlock x:Name="statusText" Grid.Row="0" Text="Score: 0" FontSize="24" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- the four tiles -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="20,0">
                <Border x:Name="tile0" Background="#64B5F6" CornerRadius="16" Margin="10" BorderBrush="Transparent" BorderThickness="6">
                    <Image x:Name="tileImg0" Stretch="Uniform" Margin="20"/>
                </Border>
                <Border x:Name="tile1" Background="#BA68C8" CornerRadius="16" Margin="10" BorderBrush="Transparent" BorderThickness="6">
                    <Image x:Name="tileImg1" Stretch="Uniform" Margin="20"/>
                </Border>
                <Border x:Name="tile2" Background="#F06292" CornerRadius="16" Margin="10" BorderBrush="Transparent" BorderThickness="6">
                    <Image x:Name="tileImg2" Stretch="Uniform" Margin="20"/>
                </Border>
                <Border x:Name="tile3" Background="#FFB74D" CornerRadius="16" Margin="10" BorderBrush="Transparent" BorderThickness="6">
                    <Image x:Name="tileImg3" Stretch="Uniform" Margin="20"/>
                </Border>
            </UniformGrid>

            <!-- small helper view: depth image + debug text -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="kinectDepthImage" Grid.Column="0" Margin="10" Stretch="Uniform"/>
            </Grid>
        </Grid>

        <!-- game over screen -->
        <Grid x:Name="gameOverGrid" Visibility="Collapsed" Background="#1E1E24">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="gameOverText" Text="Game Over" FontSize="40" Foreground="White"
                           FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="finalScoreText" Text="Score: 0" FontSize="24" Foreground="#DDDDDD"
                           HorizontalAlignment="Center" Margin="0,10,0,25"/>
                <Button Content="Play again" FontSize="18" Height="45" Width="200"
                        Click="RestartButton_Click" Background="#64B5F6" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
